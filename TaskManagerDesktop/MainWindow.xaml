<Window x:Class="TaskManagerDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagerDesktop"
        mc:Ignorable="d"
        Title="TaskManager - Управление задачами"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="WrapTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxHeight" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Новая задача" Command="{Binding AddTaskCommand}"/>
                <Separator/>
                <MenuItem Header="_Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Задачи">
                <MenuItem Header="_Добавить" Command="{Binding AddTaskCommand}"/>
                <MenuItem Header="_Редактировать" Command="{Binding EditTaskCommand}"/>
                <MenuItem Header="_Удалить" Command="{Binding DeleteTaskCommand}"/>
                <Separator/>
                <MenuItem Header="_Отметить как выполненную" Command="{Binding MarkAsCompletedCommand}"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="_Обновить" Command="{Binding RefreshCommand}"/>
                <Separator/>
                <CheckBox IsChecked="{Binding IsGroupByPriority}" Content="Группировать по приоритету"/>
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="_О программе"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="White">
            <Button ToolTip="Добавить новую задачу" Command="{Binding AddTaskCommand}" Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" Margin="0,0,5,0"/>
                    <TextBlock Text="Добавить"/>
                </StackPanel>
            </Button>
            <Button ToolTip="Удалить выбранную задачу" Command="{Binding DeleteTaskCommand}" Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="-" Margin="0,0,5,0"/>
                    <TextBlock Text="Удалить"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button ToolTip="Обновить список задач" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="R" Margin="0,0,5,0"/>
                    <TextBlock Text="Обновить"/>
                </StackPanel>
            </Button>

            <Button Content="Тест БД (C#)"
       Click="TestDatabaseButton_Click"
       Style="{StaticResource SecondaryButtonStyle}"
       Margin="5,0,0,0">
                <Button.ToolTip>
                    <ToolTip>Тестирование подключения к базе данных (C#)</ToolTip>
                </Button.ToolTip>
            </Button>

            <Button ToolTip="Перезагрузить данные из БД"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                        <TextBlock Text="!!!!" Margin="0,0,5,0"/>
                        <TextBlock Text="Перезагрузить"/>
                    </StackPanel>
            </Button>

            <Button Content="Тест CRUD"
                    Click="TextCrudButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="5,0,0,0"
                    Cursor="Hand">
                <Button.ToolTip>
                    <ToolTip>Титровка добавления и обновления задач</ToolTip>
                </Button.ToolTip>
            </Button>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Всего задач: "/>
                    <TextBlock Text="{Binding TotalTasks}" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="Выполнено: "/>
                    <TextBlock Text="{Binding CompletedTasks}" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Separator Height="15" Margin="5,0"/>
                    <TextBlock x:Name="CurrentDateText" Text="{Binding CurrentDateTime, StringFormat='dd.MM.yyyy HH:mm:ss'}" Margin="5,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="7*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="10" Padding="10" BorderBrush="#cccccc" BorderThickness="1" Background="White" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Просмотр задачи" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Название:" Margin="0,5,0,2" Foreground="#666666" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTask.Title}" Margin="0,0,0,10" Padding="5" TextWrapping="Wrap"/>

                            <TextBlock Text="Описание:" Margin="0,5,0,2" Foreground="#666666" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTask.Description}" Margin="0,0,0,10" Padding="5" TextWrapping="Wrap" MaxHeight="150"/>

                            <TextBlock Text="Срок исполнения:" Margin="0,5,0,2" Foreground="#666666" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTask.DueDate, StringFormat='dd.MM.yyyy HH:mm'}" Margin="0,0,0,10"/>

                            <TextBlock Text="Приоритет:" Margin="0,5,0,2" Foreground="#666666" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,10">
                                <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,5,0" Background="{Binding SelectedTask.PriorityColorBrush}"/>
                                <TextBlock Text="{Binding SelectedTask.Priority}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Статус:" Margin="0,5,0,2" Foreground="#666666" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTask.StatusText}" Foreground="{Binding SelectedTask.StatusColorBrush}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Категория:" Margin="0,5,0,2" Foreground="#666666" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTask.Category}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Grid.ColumnSpan="2" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>

            <Border Grid.Column="2" Margin="10" Padding="10" BorderBrush="#cccccc" BorderThickness="1" Background="White" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Список задач" FontSize="16" FontWeight="Bold" Margin="0,0,10,10" Foreground="#333333"/>

                        <TextBox x:Name="SearchTextBox" Width="200" Margin="0,0,0,10" Style="{StaticResource ModernTextBoxStyle}"
                                 VerticalAlignment="Bottom" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.ToolTip>
                                <ToolTip>Поиск по названию и описанию задачи</ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Фильтр:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666666"/>
                        <ComboBox x:Name="FilterComboBox" Width="120" Margin="0,0,10,0" Padding="5" Style="{StaticResource ModernComboBoxStyle}"
                                  SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Content">
                            <ComboBoxItem Content="Все задачи"/>
                            <ComboBoxItem Content="Активные"/>
                            <ComboBoxItem Content="Выполненные"/>
                            <ComboBoxItem Content="Просроченные"/>
                            <Separator/>
                            <ComboBoxItem Content="Работа"/>
                            <ComboBoxItem Content="Личное"/>
                            <ComboBoxItem Content="Учеба"/>
                            <ComboBoxItem Content="Здоровье"/>
                            <ComboBoxItem Content="Финансы"/>
                        </ComboBox>

                        <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="20,0,5,0" Foreground="#666666"/>
                        <ComboBox x:Name="SortComboBox" Width="120" Margin="0,0,10,0" Padding="5" Style="{StaticResource ModernComboBoxStyle}"
                                  SelectedValue="{Binding SelectedSort}" SelectedValuePath="Content">
                            <ComboBoxItem Content="По дате"/>
                            <ComboBoxItem Content="По приоритету"/>
                            <ComboBoxItem Content="По названию"/>
                            <ComboBoxItem Content="По категории"/>
                        </ComboBox>

                        <CheckBox x:Name="IsGroupByPriorityCheckBox" Content="Группировать по приоритету" Margin="20,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsGroupByPriority}"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" x:Name="TasksDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="None" RowDetailsVisibilityMode="Collapsed"
                              AlternatingRowBackground="#F9F9F9" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                              MouseDoubleClick="TasksDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Добавить задачу" Command="{Binding AddTaskCommand}"/>
                                <MenuItem Header="Редактировать" Command="{Binding EditTaskCommand}"/>
                                <MenuItem Header="Удалить" Command="{Binding DeleteTaskCommand}"/>
                                <Separator/>
                                <MenuItem Header="Отметить как выполненную" Command="{Binding MarkAsCompletedCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="MinHeight" Value="40"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" HorizontalAlignment="Center" Click="CompletionCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Приор." Width="50" SortMemberPath="Priority">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="24" Height="24" CornerRadius="12" ToolTip="{Binding Priority}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Background="{Binding PriorityColorBrush}">
                                            <TextBlock Text="{Binding PrioritySymbol}" Foreground="White" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Название" Width="*" MinWidth="150" Binding="{Binding Title}" SortMemberPath="Title"/>

                            <DataGridTextColumn Header="Описание" Width="2*" MinWidth="200" Binding="{Binding Description}" SortMemberPath="Description"
                                               ElementStyle="{StaticResource WrapTextStyle}"/>

                            <DataGridTextColumn Header="Срок" Width="100" Binding="{Binding DueDate, StringFormat='dd.MM.yyyy HH:mm'}" SortMemberPath="DueDate"/>

                            <DataGridTemplateColumn Header="Статус" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColorBrush}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Expander IsExpanded="True" Background="#FFF" BorderBrush="#CCCCCC" BorderThickness="0,6,0,1">
                                                        <Expander.Header>
                                                            <DockPanel>
                                                                <TextBlock FontWeight="Bold" Text="{Binding Name}" Margin="5,0,0,0" Foreground="#333333"/>
                                                                <TextBlock FontWeight="Bold" Text="{Binding ItemCount, StringFormat='({0})'}"/>
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                    </DataGrid>

                    <Border Grid.Row="3" Background="#F5F5F5" Margin="0,10,0,0" Padding="10" CornerRadius="3">
                        <TextBlock x:Name="ListStatsTextBlock" Text="{Binding StatusMessage}" Foreground="#666666"/>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="LoadingOverlay" Panel.ZIndex="1000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Background="#80000000" IsHitTestVisible="True">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" Padding="30" CornerRadius="10" BorderBrush="#2196F3" BorderThickness="2">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,0,0,15"/>
                        <TextBlock Text="Загрузка данных..." FontSize="16" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="300" Foreground="#666666"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>