<Window x:Class="TaskManagerDesktop.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagerDesktop"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="700"
        Width="400"
        MinHeight="400"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <local:PriorityDisplayConverter x:Key="PriorityDisplayConverter"/>
        <local:PriorityToBrushConverter x:Key="PriorityToBrushConverter"/>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="0"
                       Text="{Binding WindowTitle}"
                       Style="{StaticResource HeaderTextStyle}"
                       HorizontalAlignment="Center"/>

            <!-- Форма -->
            <StackPanel Grid.Row="1" Margin="0,0,0,0" MinHeight="300">
                <!-- Название -->
                <TextBlock Text="Название задачи:"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="TitleTextBox"
                         Text="{Binding CurrentTask.Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         MaxLength="200"/>

                <!-- Описание -->
                <TextBlock Text="Описание:"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Text="{Binding CurrentTask.Description}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="1000"/>

                <!-- Дата выполнения -->
                <TextBlock Text="Дата выполнения:"
                           Style="{StaticResource LabelTextStyle}"/>
                <DatePicker SelectedDate="{Binding CurrentTask.DueDate, ValidatesOnDataErrors=True}"
                            Style="{StaticResource ModernDatePickerStyle}"/>

                <!-- Время выполнения -->
                <TextBlock Text="Время выполнения:"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Text="{Binding DueTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         ToolTip="Введите время в формате ЧЧ:ММ (24-часовой), например: 14:30"/>

                <!-- Приоритет -->
                <TextBlock Text="Приоритет:"
                           Style="{StaticResource LabelTextStyle}"/>
                <ComboBox ItemsSource="{Binding Priorities}"
                          SelectedItem="{Binding SelectedPriority}"
                          Style="{StaticResource ModernComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12"
                                        Height="12"
                                        CornerRadius="6"
                                        Margin="0,0,8,0"
                                        Background="{Binding ColorCode, Converter={StaticResource ColorToBrushConverter}}"/>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Категория -->
                <TextBlock Text="Категория:"
                           Style="{StaticResource LabelTextStyle}"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding CurrentTask.Category}"
                          Style="{StaticResource ModernComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconCode}"
                                    Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Статус -->
                <CheckBox IsChecked="{Binding CurrentTask.IsCompleted}"
                          Content="Задача выполнена"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          Margin="0,20,0,20"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
                <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="100"
                    Height="35"/>

                <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0" 
                    Cursor="Hand"/>

                <Button Command="{Binding SaveCommand}"
                        CommandParameter="{Binding}"
                        Width="100"
                        Height="35"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <!-- Базовое содержимое -->
                            <Setter Property="Content" Value="Сохранить"/>

                            <!-- Триггеры для состояния сохранения -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                    <Setter Property="Content" Value="Сохранение..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>